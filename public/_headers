# Cloudflare Pages headers. The Content-Security-Policy is added to the /* block after the build
# by scripts/csp.ts (it needs the hashes of the inline scripts).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# Keep preview and branch deployments (<hash>.<project>.pages.dev) out of search results.
# The production *.pages.dev host does not match, so it stays indexable until a custom domain exists.
# TODO(verify): host placeholder matching on the current Cloudflare Pages platform.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Incident Kit download: unguessable path, linked only from the kit email. Not for search.
/kit/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
