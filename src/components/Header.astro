---
import { site } from '../config/site';
import { localizedPath, type Locale } from '../i18n/config';
import { t } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  /** Dark in both themes, to sit on a night band (the home hero). */
  night?: boolean;
}

const { locale, night = false } = Astro.props;
const s = t(locale);
const home = localizedPath(locale, '/');
---

<header class:list={['site-header', { night }]}>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={home}>
      <Logo />
      {site.name}
    </a>
    <nav aria-label={s.nav.label} class="site-header__navwrap">
      <ul class="site-header__nav">
        <li>
          <a href={localizedPath(locale, '/on-call/')}>{s.nav.oncall}</a>
        </li>
        <li>
          <a href={localizedPath(locale, '/cra/')}>{s.nav.cra}</a>
        </li>
        <li>
          <a href={localizedPath(locale, '/guides/')}>{s.nav.guides}</a>
        </li>
        <li>
          <a href={localizedPath(locale, '/deadlines/')}>{s.nav.calculator}</a>
        </li>
        <li>
          <a href={localizedPath(locale, '/incident-kit/')}>{s.nav.kit}</a>
        </li>
        <li>
          <a href={localizedPath(locale, '/pricing/')}>{s.nav.pricing}</a>
        </li>
      </ul>
    </nav>
    <a class="button site-header__cta" href={localizedPath(locale, '/early-access/')}>
      {s.nav.earlyAccess}
    </a>
  </div>
</header>

<script>
  // Publish the header's real height as --header-h (links wrap differently at each width), so
  // anchors and sticky panels such as the calculator result sit just below it.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const root = document.documentElement;
    const update = () => root.style.setProperty('--header-h', `${header.offsetHeight}px`);
    update();
    new ResizeObserver(update).observe(header);
  }
</script>

<style>
  /* Stays at the top while the page scrolls. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-height: 4rem;
    padding-block: var(--space-3);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: auto;
    font-size: var(--fs-md);
    font-weight: var(--weight-heavy);
    color: var(--text);
    text-decoration: none;
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    color: var(--text);
    text-decoration: none;
  }
  .site-header__nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  /* Early access: a pill whose border has one bright arc that circles slowly. */
  @property --cta-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .site-header__cta {
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    color: var(--text);
    border: 2px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      conic-gradient(
          from var(--cta-angle),
          var(--border-strong) 0 55%,
          var(--brand) 75%,
          var(--accent) 85%,
          var(--border-strong) 100%
        )
        border-box;
    animation: cta-spin 6s linear infinite;
  }
  .site-header__cta:hover {
    border-color: transparent;
    background:
      linear-gradient(var(--surface-2), var(--surface-2)) padding-box,
      conic-gradient(
          from var(--cta-angle),
          var(--border-strong) 0 55%,
          var(--brand) 75%,
          var(--accent) 85%,
          var(--border-strong) 100%
        )
        border-box;
  }
  @keyframes cta-spin {
    to {
      --cta-angle: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__cta {
      animation: none;
    }
  }
  /* Phones: brand and button on one row, the links on one scrollable row below, so the sticky
     header stays two rows high and does not cover much of the screen. */
  @media (max-width: 47.99rem) {
    .site-header__navwrap {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-header__nav {
      flex-wrap: nowrap;
      gap: var(--space-4);
      white-space: nowrap;
    }
  }
</style>
