---
// Links to this page in its other languages. Rendered only when the page has a translation;
// each link names its language in that language.
import { htmlLang, type Locale } from '../i18n/config';
import { t } from '../i18n';

interface Props {
  current: Locale;
  versions: { locale: Locale; href: string }[];
}

const { current, versions } = Astro.props;
const s = t(current);
---

{versions.length > 1 && (
  <nav class="lang-switch" aria-label={s.language.switcherLabel}>
    <ul>
      {versions.map((v) => (
        <li>
          {v.locale === current ? (
            <span aria-current="page" lang={htmlLang[v.locale]}>
              {t(v.locale).language.short}
            </span>
          ) : (
            <a
              href={v.href}
              hreflang={htmlLang[v.locale]}
              lang={htmlLang[v.locale]}
              data-set-language={v.locale}
              title={t(v.locale).language.name}
            >
              {t(v.locale).language.short}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* Phones: after the links, on the header's second row (see Header.astro). */
  @media (max-width: 47.99rem) {
    .lang-switch {
      order: 4;
    }
  }
  .lang-switch ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
  }
  .lang-switch a,
  .lang-switch span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding-inline: var(--space-2);
    border-radius: var(--control-radius);
  }
  .lang-switch a {
    color: var(--muted);
    text-decoration: none;
  }
  .lang-switch a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lang-switch span {
    color: var(--text);
    background: var(--surface-2);
  }
</style>
