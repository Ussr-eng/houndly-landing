---
// The Within24 mark: a "W" stroke in the text colour and a ring of eight stars in the accent
// colour that turns slowly (one turn in 24 s; still with prefers-reduced-motion).
// Eight stars in brand blue, not twelve gold ones: it must not read as the EU emblem.
// Decorative: the brand name is always written next to it.
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 300 300" aria-hidden="true">
  <path
    d="M62 92L104 212L150 120L196 212L222 140"
    fill="none"
    stroke="currentColor"
    stroke-width="30"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <g class="logo__stars">
    <polygon points="244.0,37.5 246.8,44.2 254.0,44.8 248.5,49.5 250.2,56.5 244.0,52.7 237.8,56.5 239.5,49.5 234.0,44.8 241.2,44.2"></polygon>
    <polygon points="266.6,46.9 269.4,53.5 276.6,54.1 271.1,58.8 272.8,65.9 266.6,62.1 260.5,65.9 262.1,58.8 256.6,54.1 263.9,53.5"></polygon>
    <polygon points="276.0,69.5 278.8,76.2 286.0,76.8 280.5,81.5 282.2,88.5 276.0,84.7 269.8,88.5 271.5,81.5 266.0,76.8 273.2,76.2"></polygon>
    <polygon points="266.6,92.1 269.4,98.8 276.6,99.4 271.1,104.1 272.8,111.1 266.6,107.4 260.5,111.1 262.1,104.1 256.6,99.4 263.9,98.8"></polygon>
    <polygon points="244.0,101.5 246.8,108.2 254.0,108.8 248.5,113.5 250.2,120.5 244.0,116.7 237.8,120.5 239.5,113.5 234.0,108.8 241.2,108.2"></polygon>
    <polygon points="221.4,92.1 224.1,98.8 231.4,99.4 225.9,104.1 227.5,111.1 221.4,107.4 215.2,111.1 216.9,104.1 211.4,99.4 218.6,98.8"></polygon>
    <polygon points="212.0,69.5 214.8,76.2 222.0,76.8 216.5,81.5 218.2,88.5 212.0,84.7 205.8,88.5 207.5,81.5 202.0,76.8 209.2,76.2"></polygon>
    <polygon points="221.4,46.9 224.1,53.5 231.4,54.1 225.9,58.8 227.5,65.9 221.4,62.1 215.2,65.9 216.9,58.8 211.4,54.1 218.6,53.5"></polygon>
  </g>
</svg>

<style>
  .logo {
    flex: none;
  }

  .logo__stars {
    fill: var(--accent);
    transform-box: view-box;
    transform-origin: 244px 80px;
    animation: logo-turn 24s linear infinite;
  }

  @keyframes logo-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__stars {
      animation: none;
    }
  }
</style>
