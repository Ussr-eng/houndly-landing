---
// Atkinson Hyperlegible Next (OFL), 400 + 700, Latin subset only, self-hosted via Vite.
// font-display: optional never swaps after first paint, so fonts cannot cause layout shift;
// the preload makes the 400 weight usually arrive in time.
import regular from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import bold from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-700-normal.woff2?url';

const range =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (weight: number, url: string) =>
  `@font-face{font-family:'Atkinson Hyperlegible Next';font-style:normal;font-weight:${weight};font-display:optional;src:url(${url}) format('woff2');unicode-range:${range}}`;
---

<link rel="preload" href={regular} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={face(400, regular) + face(700, bold)} />
