---
// Sign-up form for the Incident Kit and early access. Plain HTML that posts to
// /api/subscribe and works without JavaScript (303 to a status page); subscribe-form.ts
// enhances it with an inline result, Turnstile and the analytics event.
import '../../styles/forms.css';
import { t } from '../../i18n';
import type { Locale } from '../../i18n/config';
import { LAWS, LIMITS, PRODUCT_TYPES, type ListId } from '../../lib/forms/validate';
import { HONEYPOT_FIELD } from '../../lib/forms/handler';
import { paidPlanIds } from '../../config/pricing';

interface Props {
  list: ListId;
  locale: Locale;
  /** Page path, sent as SOURCE. */
  source: string;
}

const { list, locale, source } = Astro.props;
const all = t(locale);
const f = all.form;
const p = all.pricing;
const id = (name: string) => `${list}-${name}`;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const success = list === 'kit' ? all.kit.success : p.success;
const submit = list === 'kit' ? all.kit.submit : p.submit;
const privacyParts = f.privacyNote.split('{link}');
---

<form
  class="form"
  method="post"
  action="/api/subscribe"
  data-subscribe
  data-event={list === 'kit' ? 'kit_requested' : 'waitlist_submitted'}
  data-success={success}
  data-sending={f.sending}
  data-errors={JSON.stringify(f.errors)}
>
  <p class="form-summary" id={id('summary')} tabindex="-1" hidden></p>

  <input type="hidden" name="list" value={list} />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="elapsed" value="" />

  <div class="form-hp" aria-hidden="true">
    <label for={id('website')}>{f.honeypot}</label>
    <input type="text" id={id('website')} name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-field">
    <label for={id('email')}>
      {f.email} <span class="form-note">{f.required}</span>
    </label>
    <input
      type="email"
      id={id('email')}
      name="email"
      required
      autocomplete="email"
      maxlength={LIMITS.email}
      aria-describedby={id('email-error')}
    />
    <p class="form-error" id={id('email-error')} hidden></p>
  </div>

  <div class="form-field">
    <label for={id('company')}>
      {f.company} <span class="form-note">{f.optional}</span>
    </label>
    <input
      type="text"
      id={id('company')}
      name="company"
      autocomplete="organization"
      maxlength={LIMITS.company}
    />
  </div>

  <div class="form-field">
    <label for={id('product_type')}>
      {f.productType} <span class="form-note">{f.optional}</span>
    </label>
    <select id={id('product_type')} name="product_type">
      <option value="">{f.productTypeNone}</option>
      {PRODUCT_TYPES.map((v) => (
        <option value={v}>{f.productTypes[v]}</option>
      ))}
    </select>
  </div>

  <fieldset>
    <legend>
      {f.laws} <span class="form-note">{f.optional}</span>
    </legend>
    {LAWS.map((law) => (
      <label class="form-choice">
        <input type="checkbox" name="laws" value={law} />
        {f.lawLabels[law]}
      </label>
    ))}
  </fieldset>

  {list === 'waitlist' && (
    <>
      <div class="form-field">
        <label for={id('plan')}>
          {p.plan} <span class="form-note">{f.optional}</span>
        </label>
        <select id={id('plan')} name="plan" data-plan-select>
          <option value="">{p.planNone}</option>
          {paidPlanIds.map((plan) => (
            <option value={plan}>{p.plans[plan].name}</option>
          ))}
        </select>
      </div>
      <div class="form-field">
        <label for={id('current_process')}>
          {p.currentProcess} <span class="form-note">{f.optional}</span>
        </label>
        <textarea
          id={id('current_process')}
          name="current_process"
          maxlength={LIMITS.currentProcess}
          aria-describedby={id('current_process-hint')}
        />
        <p class="form-hint" id={id('current_process-hint')}>
          {p.currentProcessHint}
        </p>
      </div>
    </>
  )}

  {list === 'kit' && (
    <label class="form-choice">
      <input type="checkbox" name="news" value="yes" />
      {all.kit.news}
    </label>
  )}

  {siteKey && <div class="form-turnstile" data-sitekey={siteKey} />}

  <div>
    <button type="submit" class="button">
      {submit}
    </button>
  </div>
  <p class="form-status" role="status"></p>
  <p class="form-hint">
    {privacyParts[0]}
    <a href="/privacy/">{f.privacyLink}</a>
    {privacyParts[1]}
  </p>
</form>

<script>
  import { enhanceSubscribeForms } from '../../scripts/subscribe-form';
  enhanceSubscribeForms();
</script>
