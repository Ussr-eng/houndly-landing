---
import { site } from '../config/site';
import type { Locale } from '../i18n/config';
import { fill, t } from '../i18n';
import { currentRuleSet, verificationSummary } from '../lib/deadlines/rules';
import lock from '../../rules.lock.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const verification = verificationSummary(currentRuleSet.rules);
const rulesLine = [
  fill(s.footer.rulesVersion, { version: currentRuleSet.rule_set_version }),
  verification.allVerified && verification.latestVerifiedAt
    ? fill(s.footer.rulesVerified, { date: verification.latestVerifiedAt })
    : s.footer.rulesUnverified,
].join(' · ');
const commit = lock.backend_commit?.slice(0, 7);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>{s.footer.notLegalAdvice}</p>
    <p
      data-rules-version={currentRuleSet.rule_set_version}
      title={commit && `Rules commit ${commit}`}
    >
      {rulesLine}
    </p>
    <p>
      © {new Date().getFullYear()} {site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
  }
  .site-footer p {
    margin: 0;
  }
</style>
