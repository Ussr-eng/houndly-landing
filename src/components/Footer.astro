---
import { site } from '../config/site';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { fill, t } from '../i18n';
import { currentRuleSet, verificationSummary } from '../lib/deadlines/rules';
import lock from '../../rules.lock.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const verification = verificationSummary(currentRuleSet.rules);
const rulesLine = [
  fill(s.footer.rulesVersion, { version: currentRuleSet.rule_set_version }),
  verification.allVerified && verification.latestVerifiedAt
    ? fill(s.footer.rulesVerified, { date: verification.latestVerifiedAt })
    : s.footer.rulesUnverified,
].join(' · ');
// backend_commit is null while rules are edited in this repository (see CLAUDE.md).
const commit = (lock.backend_commit as string | null)?.slice(0, 7);
const cra = localizedPath(locale, '/cra/');
const columns = [
  {
    heading: s.footer.craHeading,
    links: [
      { href: cra, label: s.footer.craLinks.asks },
      { href: `${cra}#dates`, label: s.footer.craLinks.dates },
      { href: `${cra}#reports`, label: s.footer.craLinks.reports },
      { href: `${cra}#scope`, label: s.footer.craLinks.scope },
      { href: localizedPath(locale, '/guides/'), label: s.nav.guides },
      { href: localizedPath(locale, '/faq/'), label: s.footer.faq },
    ],
  },
  {
    heading: s.footer.toolsHeading,
    links: [
      { href: localizedPath(locale, '/deadlines/'), label: s.nav.calculator },
      { href: localizedPath(locale, '/incident-kit/'), label: s.nav.kit },
      { href: localizedPath(locale, '/pricing/'), label: s.nav.pricing },
      { href: localizedPath(locale, '/early-access/'), label: s.nav.earlyAccess },
    ],
  },
  {
    heading: s.footer.links,
    links: [
      { href: localizedPath(locale, '/privacy/'), label: s.footer.privacy },
      { href: localizedPath(locale, '/legal/'), label: s.footer.legal },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__columns">
      {columns.map((column) => (
        <nav aria-label={column.heading}>
          <h2 class="site-footer__heading">{column.heading}</h2>
          <ul class="site-footer__links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="site-footer__inner">
      <p>
        {s.footer.notLegalAdvice} {s.footer.notAffiliated}
      </p>
      <p
        data-rules-version={currentRuleSet.rule_set_version}
        title={commit && `Rules commit ${commit}`}
      >
        {rulesLine}
      </p>
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-8);
  }
  .site-footer__heading {
    margin: 0 0 var(--space-3);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer__links {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    color: var(--muted);
  }
  .site-footer__links a:hover {
    color: var(--accent);
  }
</style>
