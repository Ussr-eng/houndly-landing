---
import StatusPage from '../../../components/StatusPage.astro';
import { t } from '../../../i18n';
import { localeStaticPaths, pageLocale } from '../../../i18n/routes';

export const getStaticPaths = localeStaticPaths;
const locale = pageLocale(Astro.currentLocale);

const s = t(locale).kit.checkEmail;
---

<StatusPage
  title={s.title}
  description={s.description}
  body={s.body}
  hint={s.hint}
  links={[{ href: '/deadlines/', label: s.back }]}
/>
