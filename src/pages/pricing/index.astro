---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/forms/SubscribeForm.astro';
import PlanList from '../../components/PlanList.astro';
import { fill, t } from '../../i18n';
import { starterPlan } from '../../config/pricing';

const s = t('en').pricing;
const perTeam = fill(s.perTeam, {
  people: starterPlan.peopleOnCall ?? 0,
  price: starterPlan.price,
});
---

<BaseLayout title={s.title} description={s.description}>
  <div class="pricing">
    <div class="prose">
      <h1>{s.title}</h1>
      <p class="lead">{s.intro}</p>
      <p>{perTeam}</p>
    </div>

    <PlanList formPath="/pricing/" headingLevel={2} />
    <p class="pricing-note">
      {s.oncallOnly} {s.priceLock} {s.pagerDuty} {s.consultant}
    </p>

    <section id="early-access" class="early-access" aria-labelledby="early-access-heading">
      <h2 id="early-access-heading">{s.formHeading}</h2>
      <p>{s.formIntro}</p>
      <SubscribeForm list="waitlist" locale="en" source="/pricing/" />
    </section>
  </div>
</BaseLayout>

<script>
  import { enhancePlanButtons } from '../../scripts/pricing';
  import { applyWaitlistContext } from '../../scripts/waitlist-context';
  enhancePlanButtons();
  applyWaitlistContext();
</script>

<style>
  .pricing {
    display: grid;
    gap: var(--space-8);
    margin-block: var(--space-4) var(--space-12);
  }

  .pricing-note {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .early-access {
    max-width: 40rem;
    scroll-margin-top: var(--space-4);
  }

  .early-access h2 {
    font-size: var(--fs-lg);
  }
</style>
