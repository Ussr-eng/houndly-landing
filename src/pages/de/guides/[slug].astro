---
// German guides. Only some guides are translated: related guides that have no German version
// link to the English one, and so do the pages around the guide (see GuideLayout).
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { guideTranslations, publishedGuides } from '../../../lib/guides';
import type { Locale } from '../../../i18n/config';

const locale: Locale = 'de';

export const getStaticPaths = (async () => {
  const all = await getCollection('guides');
  const english = new Map(
    publishedGuides(all.filter((g) => g.data.locale === 'en')).map((g) => [g.data.slug, g]),
  );
  const german = all.filter((g) => g.data.locale === 'de' && !g.data.draft);
  const germanBySlug = new Map(german.map((g) => [g.data.slug, g]));
  return german.map((guide) => ({
    params: { slug: guide.data.slug },
    props: {
      guide,
      translations: guideTranslations(all, guide.data.slug),
      related: guide.data.related.map((slug) => {
        const own = germanBySlug.get(slug);
        const fallback = english.get(slug);
        if (!own && !fallback)
          throw new Error(`Guide "de/${guide.data.slug}" links to missing related guide: ${slug}`);
        return {
          slug,
          title: (own ?? fallback)?.data.title ?? slug,
          locale: (own ? 'de' : 'en') as Locale,
        };
      }),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  guide: CollectionEntry<'guides'>;
  translations: Locale[];
  related: { slug: string; title: string; locale: Locale }[];
}

const { guide, translations, related } = Astro.props;
if (guide.data.locale !== locale) throw new Error('de/guides: not a German guide');
const { Content } = await render(guide);
---

<GuideLayout guide={guide.data} related={related} translations={translations}>
  <Content />
</GuideLayout>
