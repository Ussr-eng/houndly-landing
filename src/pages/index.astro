---
// Home: the entry to the funnel. Positioning, how it works, pricing and the early-access form.
// The deadline calculator lives on /deadlines/; old shared calculator links are forwarded there.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanList from '../components/PlanList.astro';
import HeroIncident from '../components/HeroIncident.astro';
import SubscribeForm from '../components/forms/SubscribeForm.astro';
import { DateTime } from 'luxon';
import { fill, t } from '../i18n';
import { milestoneStatus } from '../lib/milestone';

const all = t('en');
const s = all.home;
const p = all.pricing;

// Worked out at build time, so the page reads correctly without JavaScript.
const buildTime = DateTime.utc();
const dates = s.cra.dates.map((d) => {
  const status = milestoneStatus(d.date, buildTime);
  return {
    ...d,
    done: status.kind === 'done',
    status:
      status.kind === 'done'
        ? d.done
        : status.months < 1
          ? s.cra.upcomingSoon
          : fill(s.cra.upcoming, { months: status.months }),
  };
});
---

<BaseLayout title={s.title} description={s.description} bleed nightHeader>
  <section class="hero night" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 id="hero-heading">{s.heading}</h1>
        <p class="hero__intro">{s.intro}</p>
        <div class="hero__actions">
          <a class="button button--large" href="/deadlines/">
            {s.primary}
          </a>
          <a class="button button--large button--secondary" href="#early-access">
            {s.secondary}
          </a>
        </div>
        <p class="hero__status">{s.status}</p>
      </div>
      <div class="hero__visual">
        <HeroIncident />
      </div>
    </div>
  </section>

  <section class="band band--tint" aria-labelledby="pain-heading">
    <div class="container">
      <h2 id="pain-heading">{s.pain.heading}</h2>
      <ul class="pain">
        {s.pain.items.map((item, i) => (
          <li class:list={['pain__item', `pain__item--${i + 1}`]}>
            <span class="pain__marker" aria-hidden="true">
              {s.pain.markers[i]}
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="cra" class="band" aria-labelledby="cra-heading">
    <div class="container">
      <h2 id="cra-heading">{s.cra.heading}</h2>
      <p class="band__intro">{s.cra.intro}</p>
      <dl class="facts">
        {s.cra.facts.map((fact) => (
          <div class="fact">
            <dt>{fact.name}</dt>
            <dd>
              {fact.text}
              <span class="ref">{fact.ref}</span>
            </dd>
          </div>
        ))}
      </dl>

      <h3 id="cra-dates" class="dates__heading">
        {s.cra.datesHeading}
      </h3>
      <ol class="dates">
        {dates.map((d) => (
          <li class:list={['date', { 'date--done': d.done }]}>
            <span class="date__marker" aria-hidden="true" />
            <time datetime={d.date} class="date__when">
              {d.label}
            </time>
            <span class="date__status">{d.status}</span>
            <p>
              {d.text}
              {d.ref && <span class="ref">{d.ref}</span>}
            </p>
          </li>
        ))}
      </ol>
      <p>
        <a href="/deadlines/">{s.cra.link}</a>
      </p>
    </div>
  </section>

  <section id="reports" class="band band--tint" aria-labelledby="reports-heading">
    <div class="container">
      <h2 id="reports-heading">{s.reports.heading}</h2>
      <p class="band__intro">{s.reports.intro}</p>
      <ol class="reports">
        {s.reports.stages.map((stage, i) => (
          <li class:list={['report', `report--${i + 1}`]}>
            <div class="report__head">
              <h3>{stage.name}</h3>
              <p class="report__due">
                <span class="visually-hidden">{s.reports.due}: </span>
                {stage.due}
              </p>
            </div>
            <dl class="report__body">
              <div>
                <dt>{s.reports.covers}</dt>
                <dd>{stage.covers}</dd>
              </div>
              <div>
                <dt>{s.reports.within24}</dt>
                <dd>{stage.within24}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ol>
      <p class="note">{s.reports.users}</p>
    </div>
  </section>

  <section class="band" aria-labelledby="how-heading">
    <div class="container">
      <h2 id="how-heading">{s.how.heading}</h2>
      <ol class="steps">
        {s.how.steps.map((step, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--tint" aria-labelledby="oncall-heading">
    <div class="container">
      <h2 id="oncall-heading">
        {s.oncall.heading} <span class="badge">{s.oncall.badge}</span>
      </h2>
      <ul class="panels">
        {s.oncall.items.map((item) => (
          <li class="panel">
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      <p class="note">{s.oncall.opsgenie}</p>
    </div>
  </section>

  <section id="scope" class="band" aria-labelledby="scope-heading">
    <div class="container">
      <h2 id="scope-heading">{s.scope.heading}</h2>
      <p class="band__intro">{s.scope.intro}</p>
      <table class="scope">
        <thead>
          <tr>
            <th scope="col">{s.scope.shipHeading}</th>
            <th scope="col">{s.scope.usuallyHeading}</th>
          </tr>
        </thead>
        <tbody>
          {s.scope.items.map((item) => (
            <tr>
              <th scope="row">{item.name}</th>
              <td>{item.text}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="scope__link">
        <a href="/deadlines/">{s.scope.link}</a>
      </p>
    </div>
  </section>

  <section class="band band--tint" aria-labelledby="pricing-heading">
    <div class="container">
      <h2 id="pricing-heading">{s.pricing.heading}</h2>
      <p class="band__intro">{s.pricing.intro}</p>
      <PlanList formPath="/" headingLevel={3} />
      <p class="note">
        {p.priceLock} {p.consultant}
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="trust-heading">
    <div class="container">
      <h2 id="trust-heading">{s.trust.heading}</h2>
      <ul class="trust">
        {s.trust.items.map((item) => (
          <li>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      <p>
        <a href="/privacy/">{s.trust.privacy}</a>
      </p>
    </div>
  </section>

  <section class="band band--tint" aria-labelledby="faq-heading">
    <div class="container faq-layout">
      <h2 id="faq-heading">{s.faq.heading}</h2>
      <dl class="faq">
        {s.faq.items.map((item) => (
          <div class="faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="early-access" class="band night early-access" aria-labelledby="early-access-heading">
    <div class="container early-access__inner">
      <div class="early-access__copy">
        <h2 id="early-access-heading">{p.formHeading}</h2>
        <p>{p.formIntro}</p>
      </div>
      <div class="early-access__form">
        <SubscribeForm list="waitlist" locale="en" source="/" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { enhancePlanButtons } from '../scripts/pricing';
  import { forwardCalculatorLink } from '../scripts/home';
  forwardCalculatorLink();
  enhancePlanButtons();
</script>

<style>
  /* Hero: a night band in both themes, with the incident illustration beside the copy. */
  .hero {
    background:
      radial-gradient(60rem 30rem at 80% 20%, var(--night-glow) 0%, transparent 70%), var(--bg);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-24);
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }

  .hero h1 {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: var(--weight-heavy);
    line-height: var(--lh-display);
    letter-spacing: -0.02em;
  }

  .hero__intro {
    max-width: 38rem;
    margin: var(--space-6) 0 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__status {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  /* Sections: full-width bands, alternating with a tinted background. */
  .band {
    padding-block: var(--space-16);
    scroll-margin-top: var(--space-4);
  }

  .band--tint {
    background: var(--bg-2);
    border-block: 1px solid var(--border);
  }

  .band h2 {
    margin: 0 0 var(--space-8);
    font-size: var(--fs-xl);
    font-weight: var(--weight-heavy);
    letter-spacing: -0.01em;
  }

  .band__intro {
    max-width: var(--measure);
    margin: calc(-1 * var(--space-6)) 0 var(--space-8);
    color: var(--muted);
    font-size: var(--fs-md);
  }

  .band h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-md);
  }

  .band li > p {
    margin: 0;
  }

  .pain,
  .steps,
  .panels,
  .trust {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .pain {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .panels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pain__item {
    font-size: var(--fs-md);
  }

  .pain__marker {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    line-height: 1.2;
  }

  .pain__item--1 .pain__marker {
    color: var(--overdue);
  }

  .pain__item--2 .pain__marker {
    color: var(--soon);
  }

  .pain__item--3 .pain__marker {
    color: var(--accent);
  }

  /* How it works: numbered stops on one line, like a timeline. */
  .steps {
    gap: var(--space-8) var(--space-6);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-top: 1.125rem;
      border-top: 2px solid var(--border);
    }
    .step__num {
      margin-top: calc(-1.125rem - 1.125rem - 1px);
    }
  }

  .step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: var(--space-4);
    font-weight: var(--weight-heavy);
    color: var(--brand-contrast);
    background: var(--brand);
    border-radius: 50%;
  }

  .step p,
  .trust p {
    color: var(--muted);
  }

  .panel {
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .badge {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    color: var(--soon);
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
    vertical-align: middle;
    border: 1px solid currentColor;
    border-radius: 999px;
    letter-spacing: 0;
  }

  .note {
    margin: var(--space-6) 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .trust li {
    padding-top: var(--space-4);
    border-top: 2px solid var(--brand);
  }

  /* FAQ: heading on the left, questions on the right on wide screens. */
  @media (min-width: 64rem) {
    .faq-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-12);
    }
  }

  .faq {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .faq__item {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .faq dt {
    font-size: var(--fs-md);
    font-weight: var(--weight-bold);
  }

  .faq dd {
    max-width: var(--measure);
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }

  /* The CRA: four facts, then the key dates as stops on one line. */
  .ref {
    display: block;
    margin-top: var(--space-1);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .facts {
    display: grid;
    gap: var(--space-6) var(--space-8);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .fact {
    padding-left: var(--space-4);
    border-left: 2px solid var(--brand);
  }

  .fact dt {
    font-size: var(--fs-md);
    font-weight: var(--weight-bold);
  }

  .fact dd {
    margin: var(--space-1) 0 0;
  }

  .band .dates__heading {
    margin: var(--space-16) 0 var(--space-8);
    font-size: var(--fs-lg);
  }

  .dates {
    display: grid;
    gap: var(--space-8) var(--space-6);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  .date {
    position: relative;
    padding-left: var(--space-8);
  }

  /* Phones: a vertical line down the left; wider screens: one horizontal line. */
  .date::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: calc(-1 * var(--space-8));
    left: calc(var(--marker) / 2 - 1px);
    border-left: 2px solid var(--border);
  }

  .date:last-child::before {
    display: none;
  }

  .date__marker {
    position: absolute;
    top: 0.25rem;
    left: 0;
    width: var(--marker);
    height: var(--marker);
    background: var(--bg);
    border: 2px solid var(--soon);
    border-radius: 50%;
  }

  .date--done .date__marker {
    background: var(--ok);
    border-color: var(--ok);
  }

  @media (min-width: 48rem) {
    .dates {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-top: var(--space-8);
      border-top: 2px solid var(--border);
    }
    .date {
      padding-left: 0;
    }
    .date::before {
      display: none;
    }
    .date__marker {
      top: calc(-1 * var(--space-8) - var(--marker) / 2 - 1px);
    }
  }

  .date__when {
    display: block;
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
  }

  .date__status {
    display: inline-block;
    margin-top: var(--space-1);
    padding: 0 var(--space-2);
    color: var(--soon);
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .date--done .date__status {
    color: var(--ok);
  }

  .date p {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }

  /* Three reports: one lane per stage, coloured like the lanes in the hero. */
  .reports {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .report {
    display: grid;
    gap: var(--space-4) var(--space-8);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--lane, var(--accent));
    border-radius: var(--radius-panel);
  }

  .report--1 {
    --lane: var(--overdue);
  }

  .report--2 {
    --lane: var(--soon);
  }

  .report--3 {
    --lane: var(--accent);
  }

  @media (min-width: 64rem) {
    .report {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    }
  }

  .report__due {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .report__body {
    display: grid;
    gap: var(--space-4) var(--space-8);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .report__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .report__body dt {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
  }

  .report__body dd {
    margin: var(--space-1) 0 0;
  }

  /* Does it apply: a plain two-column table that stacks on phones. */
  .scope {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }

  .scope thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .scope th,
  .scope td {
    display: block;
    padding: 0;
    text-align: left;
    vertical-align: top;
  }

  .scope tr {
    display: block;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .scope tbody th {
    font-weight: var(--weight-bold);
  }

  .scope td {
    margin-top: var(--space-1);
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .scope tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-8);
    }
    .scope td {
      margin-top: 0;
    }
  }

  .scope__link {
    margin: var(--space-6) 0 0;
  }

  .early-access__inner {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .early-access__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-16);
    }
  }

  .early-access__copy p {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-md);
  }
</style>
