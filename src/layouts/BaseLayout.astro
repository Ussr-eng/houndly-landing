---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import Fonts from '../components/Fonts.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageHint from '../components/LanguageHint.astro';
import CraCheck from '../components/cra-check/CraCheck';
import { buildSeo } from '../lib/seo/build';
import { allowIndexing, apiOrigin, site, siteUrl } from '../config/site';
import { isNoindexByDesign } from '../config/indexing';
import {
  defaultLocale,
  htmlLang,
  localizedPath,
  ogLocale,
  normalizePath,
  siteLocale,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Locale-neutral path for hreflang; defaults to the current URL path. */
  neutralPath?: string;
  /** Locales this page exists in. More than one adds hreflang tags; default: this page only. */
  translations?: readonly Locale[];
  ogImage?: string;
  /** Alt text for ogImage; defaults to the site-wide one. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Full-width page: sections set their own containers (the home page). */
  bleed?: boolean;
  /** Dark header in both themes, for a page that opens with a night band. */
  nightHeader?: boolean;
}

const {
  title,
  description,
  locale = defaultLocale,
  neutralPath,
  translations,
  ogImage = site.defaultOgImage,
  ogImageAlt = site.ogImageAlt,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  bleed = false,
  nightHeader = false,
} = Astro.props;

const path = Astro.url.pathname === '/404.html' ? '/404/' : normalizePath(Astro.url.pathname);
const seo = buildSeo({
  title,
  description,
  path,
  origin: siteUrl(),
  ogImage,
  ogImageAlt,
  ogType,
  ogLocale: ogLocale[locale],
  siteName: site.name,
  // While the global switch is off, every page is noindex; status pages always are.
  noindex: noindex || !allowIndexing() || isNoindexByDesign(path),
  locales: translations ?? [locale],
  defaultLocale,
  ...(neutralPath ? { neutralPath } : {}),
});
const s = t(locale);
// Header and footer follow the locale only when the whole site exists in it.
const chrome = siteLocale(locale);
// This page in each language it exists in, for the switcher and the browser-language hint.
// Status pages (noindex by design) have no translations to offer.
const versions =
  translations && translations.length > 1 && !isNoindexByDesign(path)
    ? translations.map((l) => ({
        locale: l,
        href: localizedPath(l, neutralPath ?? path),
      }))
    : [];
const api = apiOrigin();
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Fonts />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo seo={seo} jsonLd={jsonLd} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {s.skipToContent}
    </a>
    <Header locale={chrome} night={nightHeader} current={locale} versions={versions} />
    <LanguageHint current={locale} versions={versions} />
    <main id="main" class:list={[{ container: !bleed }]} tabindex="-1">
      <slot />
    </main>
    <Footer locale={chrome} />
    {api && <CraCheck client:idle apiOrigin={api} turnstileSiteKey={turnstileSiteKey} />}
  </body>
</html>
