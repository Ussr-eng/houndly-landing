---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import Fonts from '../components/Fonts.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageHint from '../components/LanguageHint.astro';
import CraCheck from '../components/cra-check/CraCheck';
import { buildSeo } from '../lib/seo/build';
import { allowIndexing, apiOrigin, site, siteUrl } from '../config/site';
import { isNoindexByDesign } from '../config/indexing';
import {
  defaultLocale,
  htmlLang,
  localizedPath,
  ogLocale,
  normalizePath,
  splitLocale,
  publicLocales,
  hiddenLocales,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n';
import { pageLocale } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Locale-neutral path for hreflang; defaults to the current URL path. */
  neutralPath?: string;
  /** Public locales this page exists in (hreflang, switcher); default: every public locale. */
  translations?: readonly Locale[];
  ogImage?: string;
  /** Alt text for ogImage; defaults to the site-wide one. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Full-width page: sections set their own containers (the home page). */
  bleed?: boolean;
  /** Dark header in both themes, for a page that opens with a night band. */
  nightHeader?: boolean;
  /** Leave out the CRA check chat (the home page has its own AI guide). */
  noCraChat?: boolean;
}

const {
  title,
  description,
  locale = pageLocale(Astro.currentLocale),
  neutralPath,
  translations = publicLocales,
  ogImage = site.defaultOgImage,
  ogImageAlt = site.ogImageAlt,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  bleed = false,
  nightHeader = false,
  noCraChat = false,
} = Astro.props;

const path = Astro.url.pathname === '/404.html' ? '/404/' : normalizePath(Astro.url.pathname);
const neutral = neutralPath ?? splitLocale(path).path;
const seo = buildSeo({
  title,
  description,
  path,
  origin: siteUrl(),
  ogImage,
  ogImageAlt,
  ogType,
  ogLocale: ogLocale[locale],
  siteName: site.name,
  // While the global switch is off, every page is noindex; status pages and hidden locales
  // always are.
  noindex: noindex || !allowIndexing() || isNoindexByDesign(path) || hiddenLocales.includes(locale),
  locales: translations,
  defaultLocale,
  neutralPath: neutral,
});
const s = t(locale);
// This page in each language it exists in, for the switcher and the browser-language hint.
// Status pages have no translations to offer. A hidden locale sees itself in the switcher;
// public pages never link to it.
const shown = hiddenLocales.includes(locale) ? [...translations, locale] : translations;
const versions =
  shown.length > 1 && !isNoindexByDesign(neutral)
    ? shown.map((l) => ({ locale: l, href: localizedPath(l, neutral) }))
    : [];
const api = apiOrigin();
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Fonts />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo seo={seo} jsonLd={jsonLd} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {s.skipToContent}
    </a>
    <Header locale={locale} night={nightHeader} current={locale} versions={versions} />
    <LanguageHint
      current={locale}
      versions={
        hiddenLocales.includes(locale)
          ? []
          : versions.filter((v) => publicLocales.includes(v.locale))
      }
    />
    <main id="main" class:list={[{ container: !bleed }]} tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {api && !noCraChat && (
      <CraCheck client:idle apiOrigin={api} turnstileSiteKey={turnstileSiteKey} locale={locale} />
    )}
  </body>
</html>
