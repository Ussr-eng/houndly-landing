# Production origin, e.g. https://<project>.pages.dev. Unset = placeholder https://site-url-not-set.invalid.
PUBLIC_SITE_URL=
# "true" makes the site indexable (launch, L5). Anything else = noindex everywhere + robots.txt Disallow: /.
PUBLIC_ALLOW_INDEXING=false
# Umami Cloud website ID and the host to count. Analytics is added only when both are set (production builds).
PUBLIC_ANALYTICS_WEBSITE_ID=
PUBLIC_ANALYTICS_DOMAIN=
